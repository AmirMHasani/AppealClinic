# Session signing — REQUIRED for any shared/deployed host (e.g. Render Free).
# Generate: openssl rand -base64 32
# In production / APP_MODE=production, weak defaults are refused at session create/verify.
AUTH_SECRET=dev-secret-change-me

# demo (default) shows Development/Demo banner — not for real PHI.
# Set production only when intentionally hiding the banner (and AUTH_SECRET is strong).
APP_MODE=demo

# Redaction: SSN hits always blocked on case write APIs.
# When true, MRN/DOB-label hits also hard-block (HTTP 400). When false, non-SSN hits soft-warn.
REQUIRE_REDACTION_CHECK=false

# Public app URL (Render: https://YOUR-SERVICE.onrender.com). Used for Checkout return URLs later.
# NEXT_PUBLIC_APP_URL=

# Optional OpenAI polish (never required for core drafts).
# OPENAI_API_KEY=

# Postgres (production path on Render when durable storage is needed).
# When set, src/lib/db uses Prisma (prisma/schema.prisma). When unset, local JSON (data/store.json).
# After setting on Render: redeploy so scripts/db-release.sh runs prisma migrate deploy, then npm run seed.
# Prefer Neon free or Render Postgres. Leave unset for laptop/CI JSON-only.
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# --- Stripe ($249/mo Checkout) — LAST; leave unset for first Render demo ---
# Test keys only until Phase 2 exit + docs/stripe-go-live.md
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_LIVE_ENABLED=false
