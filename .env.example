# Session signing — REQUIRED for any shared/deployed host (e.g. Render Free).
# Generate: openssl rand -base64 32
# In production / APP_MODE=production, weak defaults are refused at session create/verify.
AUTH_SECRET=dev-secret-change-me

# demo (default) shows Development/Demo banner — not for real PHI.
# Set production only when intentionally hiding the banner (and AUTH_SECRET is strong).
APP_MODE=demo

# Redaction: SSN hits always blocked on case write APIs.
# When true, MRN/DOB-label hits also hard-block (HTTP 400). When false, non-SSN hits soft-warn.
REQUIRE_REDACTION_CHECK=false

# Public app URL (Render: https://appealclinic.onrender.com). Used for Checkout return URLs.
# NEXT_PUBLIC_APP_URL=https://appealclinic.onrender.com

# Optional OpenAI polish (never required for core drafts).
# OPENAI_API_KEY=

# Postgres — REQUIRED for durable / multi-user Render (production path).
# When set, src/lib/db uses Prisma. When unset, local JSON only (ephemeral on Free).
# On Render: start command is `npm run start:render` (prisma db push, no force-reset, then next start).
# After first deploy with DATABASE_URL: login demo@appealclinic.local / demo1234, or `npm run db:seed`.
# Prefer Neon free or Render Postgres (Internal URL). Leave unset for laptop/CI JSON-only.
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# --- Stripe TEST Checkout ($249/mo) — leave unset until ready; never enable live for Phase 1 ---
# Paste exact test values on Render (Dashboard → Environment). Do NOT commit real keys.
#
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_LIVE_ENABLED=false
#
# Webhook endpoint (Stripe Dashboard → Developers → Webhooks):
#   https://appealclinic.onrender.com/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
#
# Live keys (sk_live_/pk_live_) are rejected unless STRIPE_LIVE_ENABLED=true — keep false/unset.
